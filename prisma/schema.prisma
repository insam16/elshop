generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────
// Enums
// ───────────────────────────────────────────

enum Role {
  TEMP  // 미인증 (읽기 전용)
  USER  // 인증 완료
  ADMIN // 관리자
}

enum PostBoard {
  CREDIT   // 신용 (아이템-현금)
  ED       // ED (ED-현금)
  GENERAL  // 일반 (아이템-게임머니)
  OTHER    // 기타
}

enum PostCategory {
  SELL  // 판매
  BUY   // 구매
  TRADE // 교환
}

enum PostStatus {
  OPEN      // 거래 가능
  RESERVED  // 예약
  COMPLETED // 거래 완료
}

enum ReportReason {
  FRAUD         // 사기
  FALSE_INFO    // 허위 정보
  INAPPROPRIATE // 부적절한 내용
  IMPERSONATION // 타인 사칭
  OTHER         // 기타
}

enum ReportStatus {
  PENDING    // 접수 대기
  REVIEWING  // 검토 중
  RESOLVED   // 처리 완료
  REJECTED   // 반려
}

enum AdminActionType {
  DELETE_POST            // 게시글 삭제
  RESTORE_POST           // 게시글 복구
  RESOLVE_REPORT         // 게시글 신고 처리 완료
  REJECT_REPORT          // 게시글 신고 반려
  BAN_USER               // 사용자 제재
  UNBAN_USER             // 제재 해제
  APPROVE_USER           // 인증 승인
  REJECT_USER            // 인증 거절
  DELETE_COMMENT         // 댓글 삭제
  RESOLVE_COMMENT_REPORT // 댓글 신고 처리 완료
  REJECT_COMMENT_REPORT  // 댓글 신고 반려
}

enum NotificationType {
  COMMENT_ON_MY_POST   // 내 게시글에 댓글
  REPLY_TO_MY_COMMENT  // 내 댓글에 답글
  KEYWORD_MATCH        // 키워드 알림
  NICKNAME_CHANGED     // 닉네임 강제 변경 (게임 닉네임 소유자 변경)
}

// ───────────────────────────────────────────
// Models
// ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  publicId      String    @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nickname      String?   @unique
  role          Role      @default(TEMP)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  retainUntil   DateTime?
  isBanned      Boolean   @default(false)
  bannedUntil   DateTime?
  hashedNaverId String?   @unique

  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  comments        Comment[]
  reports         Report[]         @relation("Reporter")
  commentReports  CommentReport[]  @relation("CommentReporter")
  adminActions    AdminAction[]    @relation("AdminActionPerformer")
  sanctionActions AdminAction[]    @relation("AdminActionTarget")

  notificationsReceived Notification[]      @relation("NotificationReceiver")
  notificationsActed    Notification[]      @relation("NotificationActor")
  notificationKeywords  NotificationKeyword[]

  @@index([email])
  @@map("users")
}

// ─── Auth.js 필수 모델 ───────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id            Int          @id @default(autoincrement())
  title         String
  content       String?
  board         PostBoard    @default(GENERAL)
  category      PostCategory
  status        PostStatus   @default(OPEN)
  negotiable    Boolean      @default(false)
  tradeMethod   String       @default("OTHER")
  characterName String?
  authorId      String
  isPremium     Boolean      @default(false)
  premiumUntil  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  author        User           @relation(fields: [authorId], references: [id])
  images        PostImage[]
  comments      Comment[]
  reports       Report[]
  adminActions  AdminAction[]
  notifications Notification[]

  @@index([authorId])
  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, board, createdAt(sort: Desc)])
  @@index([deletedAt, isPremium, premiumUntil])
  @@index([deletedAt, board, category, status])
  @@map("posts")
}

model PostImage {
  id        String   @id @default(cuid())
  postId    Int
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  authorId  String
  postId    Int
  parentId  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  author        User           @relation(fields: [authorId], references: [id])
  post          Post           @relation(fields: [postId], references: [id])
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]
  reports       CommentReport[]
  adminActions  AdminAction[]

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     Int
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  reporter     User          @relation("Reporter", fields: [reporterId], references: [id])
  post         Post          @relation(fields: [postId], references: [id])
  adminActions AdminAction[]

  @@unique([reporterId, postId])
  @@index([postId])
  @@index([status])
  @@map("reports")
}

model AdminAction {
  id         String          @id @default(cuid())
  adminId    String
  actionType AdminActionType
  note       String?
  createdAt  DateTime        @default(now())

  postId          Int?
  reportId        String?
  commentId       String?
  commentReportId String?
  targetUserId    String?

  admin         User           @relation("AdminActionPerformer", fields: [adminId], references: [id])
  post          Post?          @relation(fields: [postId], references: [id])
  report        Report?        @relation(fields: [reportId], references: [id])
  comment       Comment?       @relation(fields: [commentId], references: [id])
  commentReport CommentReport? @relation(fields: [commentReportId], references: [id])
  targetUser    User?          @relation("AdminActionTarget", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([postId])
  @@index([reportId])
  @@index([commentId])
  @@index([commentReportId])
  @@index([targetUserId])
  @@map("admin_actions")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // 수신자
  actorUserId String           // 발신자
  type        NotificationType
  title       String
  body        String?
  link        String
  isRead      Boolean          @default(false)
  postId      Int?
  commentId   String?
  createdAt   DateTime         @default(now())

  user    User     @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorUserId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationKeyword {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([isEnabled])
  @@map("notification_keywords")
}

model TempNicknameSeq {
  id  Int @id @default(1)
  seq Int @default(0)

  @@map("temp_nickname_seq")
}

model RetainedUser {
  id            String   @id @default(cuid())
  publicId      String   @unique
  nickname      String
  hashedNaverId String   @unique
  retainUntil   DateTime
  createdAt     DateTime @default(now())

  @@map("retained_users")
}

model CommentReport {
  id         String       @id @default(cuid())
  reporterId String
  commentId  String
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  reporter     User          @relation("CommentReporter", fields: [reporterId], references: [id])
  comment      Comment       @relation(fields: [commentId], references: [id])
  adminActions AdminAction[]

  @@unique([reporterId, commentId])
  @@index([commentId])
  @@index([status])
  @@map("comment_reports")
}
