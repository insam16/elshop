generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  publicId              String                @unique
  name                  String?
  email                 String?               @unique
  emailVerified         DateTime?
  image                 String?
  nickname              String?               @unique
  role                  Role                  @default(TEMP)
  createdAt             DateTime              @default(now())
  deletedAt             DateTime?
  retainUntil           DateTime?
  isBanned              Boolean               @default(false)
  bannedUntil           DateTime?
  hashedNaverId         String?               @unique
  accounts              Account[]
  adminActions          AdminAction[]         @relation("AdminActionPerformer")
  sanctionActions       AdminAction[]         @relation("AdminActionTarget")
  commentReports        CommentReport[]       @relation("CommentReporter")
  comments              Comment[]
  notificationKeywords  NotificationKeyword[]
  notificationsActed    Notification[]        @relation("NotificationActor")
  notificationsReceived Notification[]        @relation("NotificationReceiver")
  posts                 Post[]
  reports               Report[]              @relation("Reporter")
  sessions              Session[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id            Int            @id @default(autoincrement())
  title         String
  content       String?
  board         PostBoard      @default(GENERAL)
  category      PostCategory
  status        PostStatus     @default(ACTIVE)
  authorId      String
  isPremium     Boolean        @default(false)
  premiumUntil  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  characterName String?
  negotiable    Boolean        @default(false)
  tradeMethod   String         @default("OTHER")
  contact       String?
  expiresAt     DateTime?
  adminActions  AdminAction[]
  comments      Comment[]
  notifications Notification[]
  images        PostImage[]
  author        User           @relation(fields: [authorId], references: [id])
  reports       Report[]

  @@index([authorId])
  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, board, createdAt(sort: Desc)])
  @@index([deletedAt, isPremium, premiumUntil])
  @@index([deletedAt, board, category, status])
  @@map("posts")
}

model PostImage {
  id        String   @id @default(cuid())
  postId    Int
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

model Comment {
  id            String          @id @default(cuid())
  content       String
  authorId      String
  postId        Int
  parentId      String?
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  contact       String?
  adminActions  AdminAction[]
  reports       CommentReport[]
  author        User            @relation(fields: [authorId], references: [id])
  parent        Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]       @relation("CommentReplies")
  post          Post            @relation(fields: [postId], references: [id])
  notifications Notification[]

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model Report {
  id           String        @id @default(cuid())
  reporterId   String
  postId       Int
  reason       ReportReason
  detail       String?
  status       ReportStatus  @default(PENDING)
  createdAt    DateTime      @default(now())
  adminActions AdminAction[]
  post         Post          @relation(fields: [postId], references: [id])
  reporter     User          @relation("Reporter", fields: [reporterId], references: [id])

  @@unique([reporterId, postId])
  @@index([postId])
  @@index([status])
  @@map("reports")
}

model AdminAction {
  id              String          @id @default(cuid())
  adminId         String
  actionType      AdminActionType
  note            String?
  createdAt       DateTime        @default(now())
  postId          Int?
  reportId        String?
  targetUserId    String?
  commentId       String?
  commentReportId String?
  admin           User            @relation("AdminActionPerformer", fields: [adminId], references: [id])
  comment         Comment?        @relation(fields: [commentId], references: [id])
  commentReport   CommentReport?  @relation(fields: [commentReportId], references: [id])
  post            Post?           @relation(fields: [postId], references: [id])
  report          Report?         @relation(fields: [reportId], references: [id])
  targetUser      User?           @relation("AdminActionTarget", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([postId])
  @@index([reportId])
  @@index([commentId])
  @@index([commentReportId])
  @@index([targetUserId])
  @@map("admin_actions")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  actorUserId String
  type        NotificationType
  title       String
  body        String?
  link        String
  isRead      Boolean          @default(false)
  postId      Int?
  commentId   String?
  createdAt   DateTime         @default(now())
  actor       User             @relation("NotificationActor", fields: [actorUserId], references: [id])
  comment     Comment?         @relation(fields: [commentId], references: [id])
  post        Post?            @relation(fields: [postId], references: [id])
  user        User             @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationKeyword {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([isEnabled])
  @@map("notification_keywords")
}

model TempNicknameSeq {
  id  Int @id @default(1)
  seq Int @default(0)

  @@map("temp_nickname_seq")
}

model RetainedUser {
  id            String   @id @default(cuid())
  publicId      String   @unique
  nickname      String
  hashedNaverId String   @unique
  retainUntil   DateTime
  createdAt     DateTime @default(now())

  @@map("retained_users")
}

model CommentReport {
  id           String        @id @default(cuid())
  reporterId   String
  commentId    String
  reason       ReportReason
  detail       String?
  status       ReportStatus  @default(PENDING)
  createdAt    DateTime      @default(now())
  adminActions AdminAction[]
  comment      Comment       @relation(fields: [commentId], references: [id])
  reporter     User          @relation("CommentReporter", fields: [reporterId], references: [id])

  @@unique([reporterId, commentId])
  @@index([commentId])
  @@index([status])
  @@map("comment_reports")
}

enum Role {
  TEMP
  USER
  ADMIN
}

enum PostBoard {
  CREDIT
  ED
  GENERAL
  OTHER
}

enum PostCategory {
  SELL
  BUY
  TRADE
}

enum PostStatus {
  ACTIVE
  RESERVED
  COMPLETED
  EXPIRED
}

enum ReportReason {
  FRAUD
  FALSE_INFO
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum AdminActionType {
  DELETE_POST
  RESTORE_POST
  RESOLVE_REPORT
  REJECT_REPORT
  BAN_USER
  UNBAN_USER
  APPROVE_USER
  REJECT_USER
  DELETE_COMMENT
  RESOLVE_COMMENT_REPORT
  REJECT_COMMENT_REPORT
}

enum NotificationType {
  COMMENT_ON_MY_POST
  REPLY_TO_MY_COMMENT
  KEYWORD_MATCH
  NICKNAME_CHANGED
}
